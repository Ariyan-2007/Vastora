<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vastora.Domain\Vastora.Domain.csproj" />
    <ProjectReference Include="..\Vastora.Application\Vastora.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives this plain class library access to HttpContext/IHttpContextAccessor (PlatformSettings
         reads the live request's scheme+host) without pulling in ASP.NET Core hosting behavior —
         the modern replacement for the old separately-versioned Http.Abstractions NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not covered by the FrameworkReference above — genuinely external. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
