# Vastora local environment configuration — copy to .env and fill in real values.
# .env is gitignored; this example file is the one that gets committed.

# --- MongoDB ---
# A full MongoDB connection string (Atlas SRV URI or a local mongodb:// URI both work).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<appName>
MongoDb__DatabaseName=vastora

# --- JWT ---
# Any long random string works; regenerate per environment. Example: `openssl rand -base64 48`
Jwt__Secret=
Jwt__Issuer=Vastora
Jwt__Audience=VastoraClients
Jwt__AccessTokenMinutes=30

# --- Platform Super Admin seed ---
# Created automatically on first run if no PlatformSuperAdmin account exists yet.
# Leave Password blank to have a strong one generated and printed once in the startup logs.
PlatformAdmin__Email=admin@vastora.dev
PlatformAdmin__Password=

# --- Email verification (§9.34) ---
# false by default, deliberately: the only INotificationService implementation logs instead of
# sending, so turning this on before a real email provider is wired in locks every new customer
# out of every shop until someone reads the server log. Flip it in the same change that adds the
# provider.
Auth__RequireEmailVerification=false

# --- Lifecycle notifications (§9.36) ---
# Abandoned-cart, back-in-stock, low-stock and review-request sweeps. Set the interval to 0 to
# disable the background worker entirely.
Notifications__SweepIntervalMinutes=30
Notifications__AbandonedCartAfterHours=4

# --- Public links ---
# Base URL used to build customer-facing links (verification, unsubscribe, order tracking).
Platform__PublicBaseUrl=http://localhost:5000

# --- CORS (§9.11 / §9.40) ---
# Comma-free, index-suffixed form. With nothing set, CORS falls back to AllowAnyOrigin, which is
# fine for local Swagger/Postman and must not ship to production.
# Cors__AllowedOrigins__0=https://shop.example.com
# Cors__AllowedOrigins__1=https://admin.example.com
